# ---------------------------------------------------------------------------
# Example configuration. Copy to .env and edit. .env is gitignored.
#
#   Copy-Item .env.example .env
#
# NOTE: you very likely do NOT need a credential here at all. Claude Code sends
# its own token with every request and the proxy forwards it untouched. The
# variables below are only a fallback for clients that send no credential.
#
# Never commit a real key. Never put a real key in this example file.
# ---------------------------------------------------------------------------

# Fallback credential, used only if the client sends none.
AGENTROUTER_API_KEY=YOUR_KEY_HERE

# Upstream endpoint.
AGENTROUTER_UPSTREAM=https://agentrouter.org

# Local listen port. The host is always 127.0.0.1 and is not configurable.
PROXY_PORT=8787

# Retry policy for invalid/empty upstream responses.
# attempt 1 -> 500ms -> attempt 2 -> 1000ms -> attempt 3
PROXY_MAX_ATTEMPTS=3
PROXY_BACKOFF_BASE_MS=500

# Seconds to wait for the first real content event before calling the stream
# empty. Raise this if you use slow reasoning models with long thinking phases.
PROXY_PRIME_TIMEOUT_S=120

# Transport timeouts, in seconds.
PROXY_CONNECT_TIMEOUT_S=15
PROXY_READ_TIMEOUT_S=600

# Set to 1 for extra structural diagnostics. Never logs credentials, prompts,
# or model output.
PROXY_VERBOSE=0
